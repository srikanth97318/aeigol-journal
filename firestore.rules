rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------
    // Global Default-Deny Safety Net
    // Avoid wildcard rules that accidentally expose unrelated collections.
    // Default to deny for all unspecified paths.
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // Hardened Helper Primitives
    // -------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // -------------------------------------------------------------
    // Data Validation Helpers
    // -------------------------------------------------------------

    // 1. User validation (role, uid, email, displayName)
    function isValidUser(data, uid) {
      return ((!('uid' in data) || data.uid == uid) && (!('ownerUid' in data) || data.ownerUid == uid)) &&
             (!('role' in data) || (data.role is string && data.role in ['user', 'member', 'admin'])) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120));
    }

    // 2. Conversation validation (ownerUid, conversationId, title, theme, messageCount)
    function isValidConversation(data, uid, conversationId) {
      return (('ownerUid' in data && data.ownerUid == uid) || ('userId' in data && data.userId == uid)) &&
             (!('id' in data) || data.id == conversationId) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             (!('theme' in data) || (data.theme is string && data.theme.size() <= 60)) &&
             (!('lastMessagePreview' in data) || (data.lastMessagePreview is string && data.lastMessagePreview.size() <= 300)) &&
             (!('messageCount' in data) || (data.messageCount is number && data.messageCount >= 0)) &&
             (!('isArchived' in data) || (data.isArchived is bool));
    }

    // 3. Message validation (role, ownerUid, conversationId, messageId, message size)
    function isValidMessage(data, uid, conversationId, messageId) {
      return (('ownerUid' in data && data.ownerUid == uid) || ('userId' in data && data.userId == uid)) &&
             data.conversationId == conversationId &&
             (!('id' in data) || data.id == messageId) &&
             data.role == 'user' && // Direct client writes may ONLY create role='user'; assistant/model is restricted to trusted backend
             (('text' in data && data.text is string && data.text.size() >= 1 && data.text.size() <= 3000) ||
              ('content' in data && data.content is string && data.content.size() >= 1 && data.content.size() <= 3000)) &&
             (!('reflectionTags' in data) || (data.reflectionTags is list && data.reflectionTags.size() <= 10));
    }

    // 4. Summary validation (summary ownership, conversationId, summary size)
    function isValidSummary(data, uid, summaryId) {
      return (('ownerUid' in data && data.ownerUid == uid) || ('userId' in data && data.userId == uid)) &&
             (!('id' in data) || data.id == summaryId) &&
             data.conversationId is string && isValidId(data.conversationId) &&
             (!('title' in data) || (data.title is string && data.title.size() <= 120)) &&
             (('summaryText' in data && data.summaryText is string && data.summaryText.size() >= 1 && data.summaryText.size() <= 4000) ||
              ('summary' in data && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 4000)) &&
             (!('keyPoints' in data) || (data.keyPoints is list && data.keyPoints.size() <= 20)) &&
             (!('actionItems' in data) || (data.actionItems is list && data.actionItems.size() <= 20)) &&
             (!('insights' in data) || (data.insights is list && data.insights.size() <= 20));
    }

    // -------------------------------------------------------------
    // Production Exact Data Model Access Rules
    // users/{uid}
    // users/{uid}/conversations/{conversationId}
    // users/{uid}/conversations/{conversationId}/messages/{messageId}
    // users/{uid}/summaries/{summaryId}
    // -------------------------------------------------------------

    // 1. Root User Document: users/{uid}
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false; // Enumeration across users strictly forbidden
      allow create: if isOwner(uid) && isValidUser(incoming(), uid);
      allow update: if isOwner(uid) && isValidUser(incoming(), uid) &&
                       (!('uid' in incoming()) || incoming().uid == existing().uid) &&
                       (!('ownerUid' in incoming()) || incoming().ownerUid == existing().ownerUid);
      allow delete: if isOwner(uid);

      // 2. Subcollection: users/{uid}/conversations/{conversationId}
      match /conversations/{conversationId} {
        allow get: if isOwner(uid) && isValidId(conversationId);
        allow list: if isOwner(uid);
        
        // Creation validates ownership (must match authenticated UID and path {uid})
        allow create: if isOwner(uid) &&
                         isValidId(conversationId) &&
                         isValidConversation(incoming(), uid, conversationId) &&
                         ((!('ownerUid' in incoming()) || incoming().ownerUid == request.auth.uid) &&
                          (!('userId' in incoming()) || incoming().userId == request.auth.uid));
        
        // Updates preserve ownership (reject ownership transfer to another UID)
        allow update: if isOwner(uid) &&
                         isValidId(conversationId) &&
                         isValidConversation(incoming(), uid, conversationId) &&
                         ((!('ownerUid' in incoming()) || incoming().ownerUid == existing().ownerUid) &&
                          (!('userId' in incoming()) || incoming().userId == existing().userId)) &&
                         (!('id' in incoming()) || incoming().id == existing().id) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'theme', 'updatedAt', 'lastMessagePreview', 'messageCount', 'isArchived']);
        
        // Deletes verify ownership
        allow delete: if isOwner(uid) && isValidId(conversationId);

        // 3. Subcollection: users/{uid}/conversations/{conversationId}/messages/{messageId}
        match /messages/{messageId} {
          allow get: if isOwner(uid) && isValidId(conversationId) && isValidId(messageId);
          allow list: if isOwner(uid) && isValidId(conversationId);
          
          // Creation validates ownership, message role ('user' only), conversationId, and size
          allow create: if isOwner(uid) &&
                           isValidId(conversationId) &&
                           isValidId(messageId) &&
                           isValidMessage(incoming(), uid, conversationId, messageId) &&
                           ((!('ownerUid' in incoming()) || incoming().ownerUid == request.auth.uid) &&
                            (!('userId' in incoming()) || incoming().userId == request.auth.uid));
          
          // Messages are immutable audit logs (no updates permitted)
          allow update: if false;
          
          // Deletes verify ownership
          allow delete: if isOwner(uid) && isValidId(conversationId) && isValidId(messageId);
        }
      }

      // 4. Subcollection: users/{uid}/summaries/{summaryId}
      match /summaries/{summaryId} {
        allow get: if isOwner(uid) && isValidId(summaryId);
        allow list: if isOwner(uid);
        
        // Creation validates summary ownership (must match authenticated UID and path {uid})
        allow create: if isOwner(uid) &&
                         isValidId(summaryId) &&
                         isValidSummary(incoming(), uid, summaryId) &&
                         ((!('ownerUid' in incoming()) || incoming().ownerUid == request.auth.uid) &&
                          (!('userId' in incoming()) || incoming().userId == request.auth.uid));
        
        // Updates preserve ownership (reject ownership transfer to another UID)
        allow update: if isOwner(uid) &&
                         isValidId(summaryId) &&
                         isValidSummary(incoming(), uid, summaryId) &&
                         ((!('ownerUid' in incoming()) || incoming().ownerUid == existing().ownerUid) &&
                          (!('userId' in incoming()) || incoming().userId == existing().userId)) &&
                         (!('id' in incoming()) || incoming().id == existing().id) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'summary', 'summaryText', 'keyPoints', 'actionItems', 'insights', 'updatedAt']);
        
        // Deletes verify ownership
        allow delete: if isOwner(uid) && isValidId(summaryId);
      }
    }
  }
}
